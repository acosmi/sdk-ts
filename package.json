{
  "name": "@acosmi/sdk-ts",
  "version": "2.20.1",
  "description": "Acosmi TypeScript SDK：模型网关、Agent Run Gateway 与 Compliance（电子证据、时间章、报告、签署 envelope）统一客户端，支持浏览器 / Node ≥18 / Deno / Bun。",
  "type": "module",
  "main": "./dist/node/index.cjs",
  "module": "./dist/node/index.mjs",
  "types": "./dist/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "browser": "./dist/browser/index.mjs",
      "deno": "./dist/index.mjs",
      "node": {
        "types": "./dist/node/index.d.ts",
        "import": "./dist/node/index.mjs",
        "require": "./dist/node/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./adapters/anthropic": {
      "types": "./dist/node/adapters/anthropic.d.ts",
      "import": "./dist/node/adapters/anthropic.mjs",
      "require": "./dist/node/adapters/anthropic.cjs"
    },
    "./adapters/openai": {
      "types": "./dist/node/adapters/openai.d.ts",
      "import": "./dist/node/adapters/openai.mjs",
      "require": "./dist/node/adapters/openai.cjs"
    },
    "./sanitize": {
      "types": "./dist/node/sanitize/index.d.ts",
      "import": "./dist/node/sanitize/index.mjs",
      "require": "./dist/node/sanitize/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/compliance.md",
    "docs/pii-role-matrix.md",
    "docs/开发与发布手册.md",
    "examples"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "typecheck": "tsc --noEmit",
    "test:pack": "node scripts/smoke-pack.mjs",
    "docs": "typedoc",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:pack && npm run docs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "acosmi",
    "anthropic",
    "openai",
    "llm",
    "sdk",
    "compliance",
    "evidence",
    "timestamp",
    "esignature",
    "claude",
    "crabcode",
    "crabclaw"
  ],
  "license": "MIT",
  "author": "Acosmi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acosmi/sdk-ts.git"
  },
  "homepage": "https://github.com/acosmi/sdk-ts#readme",
  "bugs": {
    "url": "https://github.com/acosmi/sdk-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild@>=0.27.3 <0.28.1": "^0.28.2",
    "vite@>=8.0.0 <8.3.3": "^8.3.3",
    "markdown-it@>=14.0.0 <14.3.3": "^14.3.3",
    "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
    "brace-expansion@>=1.0.0 <1.1.21": "^1.1.21",
    "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
    "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
    "source-map-js@>=1.0.0 <1.2.2": "^1.2.2"
  }
}
